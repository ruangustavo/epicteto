# Target: one repo (personal account) or an org (org-level runner; leave REPO empty)
REPO=owner/repo
ORG=

# GitHub App (create it with: bun run scripts/create-app.ts)
APP_ID=
APP_PRIVATE_KEY_FILE=./secrets/app-private-key.pem

# Fine-grained PAT with "Pull requests: write" on the target repo(s). Only used to upload videos.
# Leave empty to run without videos.
ATTACH_TOKEN=

# Absolute path on THIS machine where worktrees, sessions, videos and the Codex credential live.
HOST_AGENT_DATA=/absolute/path/to/epicteto-data

# Optional
AGENT_MODEL=openai-codex/gpt-5.5
RUNNER_NAME=
